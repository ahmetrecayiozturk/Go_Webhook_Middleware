# --- Sunucu ---
PORT=8080

# --- PostgreSQL (Docker Compose & Uygulama) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=webhook_db
DATABASE_URL=postgres://postgres:change_me_strong_password@postgres:5432/webhook_db?sslmode=disable

# --- Redis ---
REDIS_ADDR=redis:6379

# --- Hedef ERP Adresi ---
# Docker içinden host makinedeki Mock ERP'ye erişim için host.docker.internal kullanılır
TARGET_URL=http://host.docker.internal:9000/erp/webhook

# --- Güvenlik ---
# Admin endpoint'leri (/api/v1/admin/replay-dlq) için X-API-KEY değeri
ADMIN_API_KEY=change_me_super_secret_admin_key